<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <%- include("./partials/headerstyle.ejs") %>
    <link rel="stylesheet" href="/styles/dashboard.css">
    <link rel="stylesheet" href="/styles/articles.css">
    <link rel="stylesheet" href="../styles/createblog.css">
    <script src="https://cdn.ckeditor.com/ckeditor5/29.2.0/classic/ckeditor.js"></script>
    <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.6/quill.snow.css">
    
    


</head>
<body>

    <!-- <h1> Dashboard for <span id="authorname"></span>  </h1> -->
    <div class="dashboard-header">
        <div class="dashboard-header-inner">
            <div class="mobile-sidebar" id="mobile-sidebar">
                        <i class="fa-solid fa-bars"></i>
            </div>
            <div class="dropdown-menu"></div>

            <div class="user-image-name">
                <div class="user-name">
                    <p>Collins Adi</p>
                    <div class="fa-solid fa-angle-down"></div>
                </div>
              
                <div class="userimage">
                    <img src="/images/user.png" alt="">
                </div>
                
            </div>
        </div>

    </div>
    <div class="dashboard-sidebar" id="dashboard-sidebar">

        <div class="sidebar-inner">

            <div class="dashboard-brandname">
                <h3>GIMBA</h3>
            </div>

            <div class="sidebar-buttons">

                <div class="single-button">
                    <i class="fa-solid fa-table-columns"></i>
                    <p> <a href="/dashboard"> Dashboard</a></p>
                </div>





                <div class="single-button  active-sidebar-btn">
                    <i class="fa-solid fa-newspaper"></i>
                    <p><a href="/dashboard/articles">My Articles</a> </p>
                </div>


                <div class="single-button">
                    <i class="fa-solid fa-chart-simple"></i>
                    <p> <a href="/dashboard/analytics"> Analytics</a></p>
                </div>



                <div class="single-button">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <p><a href="/dashboard/drafts">Drafts</a> </p>
                </div>

                <div class="single-button">
                    <i class="fa-solid fa-trash"></i>
                    <p> <a href="/dashboard/trash">Trash</a> </p>
                </div>

                <div class="single-button">
                    <i class="fa-solid fa-gear"></i>
                    <p> <a href="/dashboard/settings">Settings</a> </p>
                </div>

            </div>


        </div>

    </div>







    <!-- The Main DashBoard Content  -->  

    <main class="dashboard-main-page">


        <div class="create-new-blog">
            <div class="create-new-blog-inner">

                <div class="create-new-blog-title" id="create-new-blog">

                    <h3>Create a New Blog</h3>

                    <i class="fa-solid fa-angle-down"></i>

                </div>

                <div class="the-main-editor removeeditor" id="the-main-editor">

                    <%- include('./createblog.ejs') %>

                </div>

            </div>
        </div>
     
        <!-- <%- include('./createblog.ejs') %> -->

    




    </main>




    <%- include('./partials/iconscript.ejs') %>


<script src="../scripts/createblog.js" type="module"></script>
    <script src="../scripts/dashboardscript.js"></script>   

</body>
</html>

<script>

    const author = localStorage.getItem('fullName')

    document.getElementById('authorname').innerHTML = author

</script>