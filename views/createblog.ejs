<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Blog</title>
    <%- include("./partials/headerstyle.ejs") %>
    <link rel="stylesheet" href="../styles/createblog.css">
    <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.6/quill.snow.css">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>



</head>
<body>

 <!-- Including the page header -->

 <%- include("./partials/header.ejs") %>



<section class="create-page">

<div class="create-page-inner">

<div class="main-form">

    <div class="form-body">

        <form action="">

            <div class="form-top">
                <input type="text" placeholder="Blog Title" id="blog_title">
            </div>
            <div class="form-top">
                <input type="text" placeholder="Blog Snippet" id="blog_snippet">
            </div>
            <div class="form-second">
                <input type="text" placeholder="Category" id="blog_category">
                <input type="text" placeholder="Related Category" id="blog_related_category">
            </div>
            <div class="form-top">
                <input type="text" placeholder="Blog Image Url" id="blog_image_url">
            </div>
         
                <div id="editor"></div>


            <div class="create-blog-btn">
            <button id="create-blog-btn">CREATE BLOG</button>         
            </div>
              
        </form>

        

    </div>
</div>



</div>

</div>


</section>


<div class="error-message" id="error-message">

<div class="message-title">
    <h3 id="msg-title">Invalid Input</h3>
</div>
<div class="message-body">
    <p id="msg-body"> one or more field is Invalid </p>
</div>

</div>






  










<script src="../scripts/createblog.js" type="module"></script>
 <%- include("./partials/newsletter.ejs") %>
 <%- include("./partials/footer.ejs") %>
 
 <%- include('./partials/iconscript.ejs') %>






    
</body>
</html>