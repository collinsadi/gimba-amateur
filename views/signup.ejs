<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("./partials/headerstyle.ejs") %>
    <link rel="stylesheet" href="../styles/signup.css">
    <title>Sign Up</title>
</head>
<body>
    
      <!-- Including the page header -->

      <!-- <%- include("./partials/header.ejs") %> -->




        <div class="main-form-section">


            <div class="main-form-container">

                <div class="form-container-top">

                    <img src="../images/ban.png" alt="">

                </div>

                <!-- <div class="theunderline"></div> -->



                <div class="sign-up-form" id="sign-up-form">

                    <p style="color: red;" id="error-message"></p>
                    
                    <h3>Sign Up</h3>

                    <label for="fullname"> Full Name</label>
                    <input type="text" placeholder="Full Name" id="fullname">
                    <label for="email"> Email</label>
                    <input type="email" placeholder="Email" id="email">
                    <label for="password"> Password</label>
                    <input type="password" placeholder="Password" id="password">

                    <div class="submit-button">
                        <button id="signup-btn">Become an Author</button>
                    </div>
                    <p>Already an Author? <a href="" id="switch-to-login">Login</a></p>


                </div>

                 <div class="sign-up-form" id="log-in-form">
                    
                    <h3>Log In</h3>

                   
                    <label for="loginemail"> Email</label>
                    <input type="email" placeholder="Email" id="loginemail">
                    <label for="loginpassword"> Password</label>
                    <input type="password" placeholder="Password" id="loginpassword">

                    <div class="submit-button" id="login-btn">
                        <button>Log In</button>
                    </div>
                    <p>New Here? <a href="" id="switch-to-signup">Sign Up</a></p>


                </div>


            </div>


        </div>




      <!-- <%- include("./partials/newsletter.ejs") %> -->
      <%- include("./partials/footer.ejs") %>
      
      <%- include('./partials/iconscript.ejs') %>

</body>
</html>

<script>

    const switchtologin = document.querySelector("#switch-to-login");
    const switchtosignup = document.querySelector("#switch-to-signup");
    const signuppage = document.querySelector("#sign-up-form");
    const loginpage = document.getElementById("log-in-form");
    // Signup button
    const signUpBtn = document.querySelector("#signup-btn")

    switchtologin.addEventListener("click", (e)=>{
        e.preventDefault();
        signuppage.style.display = "none"
        loginpage.style.display = "block"
    })

    switchtosignup.addEventListener("click", (e)=>{
        e.preventDefault();
        signuppage.style.display = "block"
        loginpage.style.display = "none"
    })

    const fullname = document.getElementById("fullname");
    const email = document.getElementById("email");
    const password = document.getElementById("password");


// Fetch the api to create users
const CreateUsers = async () => {

    
    try {

        const response = await fetch('/api/create_user', {
            method: "POST",
            headers: {
                "Content-Type": "Application/Json"
            },
            body: JSON.stringify({
               full_name: fullname.value,
               email: email.value,
               password: password.value 
            })
        })

        const data = await response.json()
        console.log(data.message)
        
    } catch (error) {
        console.log(error)
    }

};


signUpBtn.addEventListener("click", (e)=>{
    e.preventDefault();

    const errormessage = document.getElementById('error-message');

   

    if(fullname.value === "" || password.value === "" || email.value === ""){
        errormessage.innerHTML = "All Fields are Required"
        return;
    }

    if(fullname.value.length < 3) {
        errormessage.innerHTML = "Your Full Name is Required"
        return;
    }

    if(email.value.indexOf("@") === -1){
        errormessage.innerHTML = "Please Enter a Valid Email"
        return;
    }

    if(password.value.length <= 6){
        errormessage.innerHTML = "Password must be more than 6 Characters"
        return;
    }
 e.target.innerHTML = "Working..."

    setTimeout(() => {

        CreateUsers()
        // .then(_=> location.reload())
        
    }, 2000);

})


</script>