<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GIMBA | <%= title %></title>
    <%- include("./partials/headerstyle.ejs") %>
    <link rel="stylesheet" href="../styles/singleblog.css">
</head>
<body>
    
 <!-- Including the page header -->

 <%- include("./partials/header.ejs") %>


<div class="page-hero" style="background-image: url('<%= blogpost.blog_body_image_url %>');">


    <div class="page-hero-inner">

            <div class="blog-details">

                <div class="title-of-blog">

                    <h1 id="blog-title">
                        <%= blogpost.blog_title %>
                    </h1>

                </div>
                <div class="snippet-of-blog">
                    <p><%= blogpost.blog_snippet %></p>
                </div>

                <div class="different-categories">
                    <div class="main-category"> <%= blogpost.blog_category.substring(0,12) %> </div>
                </div>

             </div>

    </div>

</div>



    


<div class="the-blog-body" id="the-blog-body">

    <!-- <p>
    <%= blogpost.blog_body %>
    </p> -->

</div>



<div class="the-author" id="the-author">

    <!-- <div class="name-badge-single">
        <p>Written By <span><a href="">Collins Adi</a></span></p>
        <i class="fa-solid fa-circle-check" title="Verified Author"></i>
    </div> -->



</div>
<div class="last-edited" >
    <p id="last-edited"></p>
</div>

<div class="report-post-share">

        <button class="share-post" id="share-post">

             <p>Share Post</p>
        <i class="fa-solid fa-copy"></i>

        </button>
       

    
    

        <button class="share-post" id="report-post">
        
        <p>Report Post</p>
        <i class="fa-solid fa-warning"></i>
        </button>
       
  
    
</div>


<div class="report-box" id="report-box">

    <div class="report-box-inner">

        <div class="report-box-top">

            <p> What is wrong with this post</p>

            <select  id="reasonforreport">
                <option value="sexual-content">Contains Sexual Content</option>
                <option value="fake-story" selected>Fake story</option>
                <option value="violence">Inciting Violence</option>
                <option value="stolen-post">Stolen Post</option>
            </select>

        </div>
        <div class="report-box-bottom">

            <div class="report-message">

                <textarea id="" placeholder="Explain in Detail What is wrong with the post"></textarea>

            </div>

           <button class="share-post">
                Submit Report
           </button>
        </div>



    </div>

</div>








 <%- include("./partials/newsletter.ejs") %>
<%- include("./partials/footer.ejs") %>

<script src="/scripts/singleblog.js"></script>
<%- include('./partials/iconscript.ejs') %>

</body>
</html>