<section class="blog-display">

  

    <div class="blog-display-inner">

        <div class="grid-title">
            <h3>Blog Grid</h3>
            <i class="fa-solid fa-arrow-turn-down"></i>
        </div>

        <div class="blogs-wrap">

            <% if (blogpost.length > 0) {%>

                   <% blogpost.forEach(element => { %>


            <div class="blogs-single-item">

            <div class="single-item-top">

                <img src="<%= element.blog_body_image_url %>" alt="">

            </div>

            <div class="single-item-bottom">

                <div class="author-date">

                    <p><%= element.createdAt.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })
                        %></p>

                    <div class="fa-solid fa-arrow-right
                    "></div>

                </div>

                <div class="blog-title-second">

                    <a href="/blog-post/<%= element._id %>">
                    <h3><%= element.blog_title %></h3>
                    </a>

                </div>

                <div class="blog-snippet-second">

                    
                    <p><%= element.blog_snippet.substring(0,150)+ " ..." %></p>
                        

                </div>

            </div>

            </div>
                
           <% }); %>
                
           <% } else {%>

            <div class="no-blog" style="margin-top: 10px; text-align: center; width: 100%;">
                <h1>OOPS!, No Blog To See Here...</h1>
                <p><a href="/create" style="text-decoration: none; color: #7F56D9; font-weight: bold;"> Create </a> Some Blogs and Return Here to See Them</p>
            </div>

           <%}%>
            



    







        </div>



    </div>



</section>



























