<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 | Page Not Found</title>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="/styles/universalstylesheet.css">



    <style>

       

        body{
        background-color: var(--white-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-family: Verdana, Geneva, Tahoma, sans-serif;
        }

        .main{

            height: 100%;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .main-inner{

            width: 98%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-direction: column;
        }

        .head h3{

            font-size: 40px;
            color: var(--primary-color);
        }
        .error-code h1{

            font-size: 200px;
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 0px;
            margin-top: 10px;

        }
        .errordescription h3{

           
            color: var(--black-color);
            margin-top: 10px;
            margin-bottom: 10px;
            font-family: Inter, sans-serif;
            font-size: 52px;
            font-weight: 700;
            line-height: 1.2em;

        }
        .errordescription span{
            color: var(--primary-color);
        }

        p {
            color: var(--primary-color);
            margin-top: 10px;
            margin-bottom: 10px;
            font-family: Inter, sans-serif;
            font-size: 16px;
            font-weight: 500;
            line-height: 1.5em;
            }
            a{
                    color: var(--white-text);
                    text-align: center;
                    letter-spacing: .5px;
                    text-transform: none;
                    background-color: var(--primary-color);
                    border: 2px solid var(--primary-color);
                    border-radius: 5px;
                    padding: 10px 30px;
                    font-family: Inter, sans-serif;
                    font-size: 16px;
                    font-weight: 500;
                    line-height: 24px;
                    transition: all .3s;
                    display: inline-block;
                    text-decoration: none;
                    margin-top: 20px;

            }
            a:hover{

                background-color: transparent;
                color: var(--black-text);
                
            }
            @media all and (max-width: 646px) { /* your content here */
            
                .errordescription h3{

                    font-size: 30px;
                }
                .error-code h1{

                    font-size: 100px;
                }
            
            
            
            }



    </style>
</head>
<body>

    <div class="main">


        <div class="main-inner">


            <div class="head">
                <h3>GIMBA</h3>
            </div>

            <div class="error-code">
                <h1>404</h1>
            </div>

            <div class="errordescription">
                <h3>Something’s <span> not right.</span></h3>
            </div>

            <div class="problem">
                <p>We can’t find the page your are looking for.</p>
            </div>

            <div class="back-btn">
                <a href="/">Back to homepage</a> 
            </div>

        </div>

    </div>

    <script src="/scripts/darkmode.js"></script>
    
</body>
</html>