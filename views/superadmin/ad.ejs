                        </div>
                        <div class="ad-description">
                            <p>Pepsi is giving away 2000, nairai to the first 5 winners</p>
                        </div>
                        <div class="ad-status">
                            <p>Active</p>
                        </div>
                        <div class="ad-controls">
                            <button>Activate</button>
                            <button> Deactivate</button>
                        </div>

                    </div> -->
                 












                </div>
            </div>




                </div>






                </div>





             

        

             




            </div>



